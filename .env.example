# คัดลอก (copy ไม่ใช่ rename) ไฟล์นี้เป็น .env แล้วเติมค่าจริงลงไป
# .env ถูก gitignore ไว้แล้ว จะไม่ถูก commit ขึ้น GitHub เด็ดขาด
# ห้ามใส่ค่าจริงลงในไฟล์ .env.example นี้

# ฐานข้อมูล — โปรเจคนี้ใช้ MySQL 8.0.13 ขึ้นไป
DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# โดเมนของเว็บ เช่น https://example.com
SITE_DOMAIN=
