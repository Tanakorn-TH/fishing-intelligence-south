# คัดลอก (copy ไม่ใช่ rename) ไฟล์นี้ไปไว้ที่ ~/.fishing-secrets/deploy.env แล้วเติมค่า
# เก็บไว้นอก repo เสมอ ไม่ต้อง commit

DEPLOY_HOST=fishing.yru.ac.th
DEPLOY_USER=fishing

# document root และโฟลเดอร์นอก document root สำหรับเก็บ .env
DEPLOY_DOCROOT=/home/fishing/web/fishing.yru.ac.th/public_html
DEPLOY_PRIVATE=/home/fishing/web/fishing.yru.ac.th/private

# กุญแจ SSH ที่ใช้ deploy
DEPLOY_SSH_KEY=

# ไม่บังคับ
DEPLOY_PORT=22
# ค่าเริ่มต้นคือ https://$DEPLOY_HOST/api/health.php
HEALTH_URL=

# ใช้เฉพาะตอนติดตั้งกุญแจ SSH ผ่าน FTPS ครั้งแรก หลังจากนั้นลบออกได้
FTP_HOST=fishing.yru.ac.th
FTP_USER=fishing
FTP_PASSWORD=
