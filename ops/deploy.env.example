# ไม่ต้องคัดลอกไฟล์นี้เอง — ops/setup-machine.sh สร้าง ~/.fishing-secrets/deploy.env ให้
# ตอนรัน deploy.cmd ครั้งแรกบนเครื่องใหม่ ไฟล์นี้มีไว้ให้ดูว่ามีค่าอะไรบ้าง
# เก็บไว้นอก repo เสมอ ไม่ต้อง commit

DEPLOY_HOST=fishing.yru.ac.th
DEPLOY_USER=fishing

# document root และโฟลเดอร์นอก document root สำหรับเก็บ .env
DEPLOY_DOCROOT=/home/fishing/web/fishing.yru.ac.th/public_html
DEPLOY_PRIVATE=/home/fishing/web/fishing.yru.ac.th/private

# กุญแจ SSH ที่ใช้ deploy — เว้นว่างได้ ค่าเริ่มต้นคือ ~/.ssh/fishing_deploy
DEPLOY_SSH_KEY=

# ไม่บังคับ
DEPLOY_PORT=22
# ค่าเริ่มต้นคือ https://$DEPLOY_HOST/api/health.php
HEALTH_URL=

# ไม่บังคับ ใช้เฉพาะตอนติดตั้งกุญแจผ่าน FTPS ค่าเริ่มต้นคือ DEPLOY_HOST / DEPLOY_USER
# รหัส FTP ไม่ต้องใส่ที่นี่ — สคริปต์ถามตอนติดตั้งกุญแจแล้วไม่เก็บลงไฟล์
FTP_HOST=
FTP_USER=
